# Groq (OpenAI-compatible API) — https://console.groq.com/keys
# Copy to `.env.local` and fill in the secret. Never commit real keys.

GROQ_API_KEY=

# Default: Llama 3.1 8B Instant — fast and lowest-cost Llama tier on Groq.
# Override only if you switch models in the Groq console docs.
GROQ_MODEL=llama-3.1-8b-instant
